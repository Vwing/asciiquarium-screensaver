#include <windows.h>
#include <scrnsave.h>
#include "resource.h"

// scrnsave.lib requires a dialog with ID DLG_SCRNSAVECONFIGURE (2003)
DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 230, 171
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Asciiquarium Screensaver"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Aquarium height (rows):", -1, 12, 15, 132, 10
    EDITTEXT IDC_ROWS, 156, 12, 54, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "40-500; fewer rows means larger art", -1, 12, 30, 198, 9

    LTEXT "Animation speed (%):", -1, 12, 50, 132, 10
    EDITTEXT IDC_SPEED, 156, 47, 54, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Fish population (%):", -1, 12, 70, 132, 10
    EDITTEXT IDC_FISH, 156, 67, 54, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Seaweed density (%):", -1, 12, 90, 132, 10
    EDITTEXT IDC_SEAWEED, 156, 87, 54, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Bubble density (%):", -1, 12, 110, 132, 10
    EDITTEXT IDC_BUBBLES, 156, 107, 54, 14, ES_AUTOHSCROLL | ES_NUMBER

    PUSHBUTTON "Restore defaults", IDC_DEFAULTS, 12, 139, 72, 17
    DEFPUSHBUTTON "OK", IDOK, 116, 139, 44, 17
    PUSHBUTTON "Cancel", IDCANCEL, 166, 139, 44, 17
END
